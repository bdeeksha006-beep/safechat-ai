# ---- Frontend (safe to expose; Supabase anon key is public-by-design) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY

# ---- Server-side only (Netlify env vars / .env for functions) ----
# NEVER prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
GEMINI_API_KEY=
OPENROUTER_API_KEY=
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_SUBJECT=mailto:admin@safechat.ai

# Which AI provider the Netlify function uses: "gemini" | "openrouter" | "rules"
AI_PROVIDER=gemini
